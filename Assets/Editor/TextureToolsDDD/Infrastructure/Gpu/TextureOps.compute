#pragma kernel Invert
#pragma kernel MergeMasks
#pragma kernel NormalOps
#pragma target 4.5

SamplerState sampler_linear_clamp;

Texture2D<float4> _Src;
RWTexture2D<float4> _Dst;

// Merge input
Texture2D<float4> _Rsrc;
Texture2D<float4> _Gsrc;
Texture2D<float4> _Bsrc;
Texture2D<float4> _Asrc;

int2 _Size;

// Invert
int _InvR, _InvG, _InvB, _InvA;

// Merge
int _Rch, _Gch, _Bch, _Ach;
int _HasR, _HasG, _HasB, _HasA;
int _InvRsrc, _InvGsrc, _InvBsrc, _InvAsrc; // ← 追加：各入力の反転
float _Rfill, _Gfill, _Bfill, _Afill;

// Normal
int _NInvR, _NInvG;
float _Strength;

float pickChannel(float4 c, int ch)
{
    if (ch == 0) return c.r;
    if (ch == 1) return c.g;
    if (ch == 2) return c.b;
    return c.a;
}

[numthreads(8,8,1)]
void Invert(uint3 id : SV_DispatchThreadID)
{
    if (id.x >= _Size.x || id.y >= _Size.y) return;
    float2 uv = (float2(id.xy) + 0.5) / float2(_Size);
    float4 c = _Src.SampleLevel(sampler_linear_clamp, uv, 0);
    if (_InvR != 0) c.r = 1.0 - c.r;
    if (_InvG != 0) c.g = 1.0 - c.g;
    if (_InvB != 0) c.b = 1.0 - c.b;
    if (_InvA != 0) c.a = 1.0 - c.a;
    _Dst[id.xy] = c;
}

[numthreads(8,8,1)]
void MergeMasks(uint3 id : SV_DispatchThreadID)
{
    if (id.x >= _Size.x || id.y >= _Size.y) return;
    float2 uv = (float2(id.xy) + 0.5) / float2(_Size);

    float4 rC = (_HasR != 0) ? _Rsrc.SampleLevel(sampler_linear_clamp, uv, 0) : float4(_Rfill, _Rfill, _Rfill, _Rfill);
    float4 gC = (_HasG != 0) ? _Gsrc.SampleLevel(sampler_linear_clamp, uv, 0) : float4(_Gfill, _Gfill, _Gfill, _Gfill);
    float4 bC = (_HasB != 0) ? _Bsrc.SampleLevel(sampler_linear_clamp, uv, 0) : float4(_Bfill, _Bfill, _Bfill, _Bfill);
    float4 aC = (_HasA != 0) ? _Asrc.SampleLevel(sampler_linear_clamp, uv, 0) : float4(_Afill, _Afill, _Afill, _Afill);

    float r = pickChannel(rC, _Rch);
    float g = pickChannel(gC, _Gch);
    float b = pickChannel(bC, _Bch);
    float a = pickChannel(aC, _Ach);

    if (_InvRsrc != 0) r = 1.0 - r;
    if (_InvGsrc != 0) g = 1.0 - g;
    if (_InvBsrc != 0) b = 1.0 - b;
    if (_InvAsrc != 0) a = 1.0 - a;

    _Dst[id.xy] = float4(r, g, b, a);
}

[numthreads(8,8,1)]
void NormalOps(uint3 id : SV_DispatchThreadID)
{
    if (id.x >= _Size.x || id.y >= _Size.y) return;
    float2 uv = (float2(id.xy) + 0.5) / float2(_Size);
    float4 c = _Src.SampleLevel(sampler_linear_clamp, uv, 0);

    if (_NInvR != 0) c.r = 1.0 - c.r;
    if (_NInvG != 0) c.g = 1.0 - c.g;

    float nx = c.r * 2.0 - 1.0;
    float ny = c.g * 2.0 - 1.0;

    nx *= _Strength;
    ny *= _Strength;

    float nz = sqrt(max(0.0, 1.0 - nx*nx - ny*ny));
    float len = max(1e-6, sqrt(nx*nx + ny*ny + nz*nz));
    nx /= len; ny /= len; nz /= len;

    c.r = nx * 0.5 + 0.5;
    c.g = ny * 0.5 + 0.5;
    c.b = nz * 0.5 + 0.5;

    _Dst[id.xy] = c;
}
